# Copy to server/.env before running the backend (`cp .env.example .env`).
# PostgreSQL required — SQLite was dropped because its file lived on the
# Render web service's ephemeral disk, which is wiped on every deploy.
#
# Option A: local Postgres via the included docker-compose.yml
#   (docker compose up -d), then:
# DATABASE_URL="postgresql://mh:mh@localhost:5432/mannhummel?schema=public"
#
# Option B: point at the same managed Postgres used in production (e.g. the
# Render Postgres instance's "External Database URL") — simplest if you
# don't have Docker installed locally:
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Optional ---
# NODE_ENV=production          # sanitizes API error responses (see index.ts)
# API_PORT=3001                # port the API binds (frontend proxy targets 3001)
# API_KEY=                     # if set, mutating routes require header x-api-key
