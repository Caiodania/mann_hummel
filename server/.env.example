# Copy to server/.env before running the backend (`cp .env.example .env`).
# SQLite by default — the DB file is created at server/prisma/dev.db.
# Prisma resolves relative SQLite paths against the schema.prisma directory.
DATABASE_URL="file:./dev.db"

# To use the Postgres container from docker-compose.yml instead, switch the
# provider in prisma/schema.prisma to "postgresql" and use e.g.:
# DATABASE_URL="postgresql://mh:mh@localhost:5432/mannhummel?schema=public"

# --- Optional ---
# NODE_ENV=production          # sanitizes API error responses (see index.ts)
# API_PORT=3001                # port the API binds (frontend proxy targets 3001)
# API_KEY=                     # if set, mutating routes require header x-api-key
